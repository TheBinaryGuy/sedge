{
    "name": "@sedge-hq/telegram",
    "version": "0.1.1",
    "description": "Telegram for sedge: message your agent from anywhere, and it answers there.",
    "keywords": [
        "agent",
        "bot",
        "sedge",
        "telegram"
    ],
    "homepage": "https://sedge.sh",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sedge-hq/sedge.git",
        "directory": "packages/telegram"
    },
    "files": [
        "src",
        "!src/**/*.test.ts"
    ],
    "type": "module",
    "exports": {
        ".": "./src/telegram.ts",
        "./bot": "./src/bot.ts",
        "./format": "./src/format.ts"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun --bun vitest run --passWithNoTests"
    },
    "dependencies": {
        "@sedge-hq/kit": "workspace:*",
        "effect": "4.1.4"
    },
    "devDependencies": {
        "@effect/vitest": "4.1.4",
        "@sedge-hq/config": "workspace:*",
        "@types/bun": "1.4.4",
        "typescript": "7.0.2",
        "vitest": "5.1.1"
    },
    "sedge": {
        "plugins": [
            "./src/telegram.ts"
        ]
    }
}
