{
    "name": "@sedge-hq/github",
    "version": "0.1.2",
    "description": "GitHub for sedge: CI that fails, reviews you're asked for, issues and PRs assigned to you.",
    "keywords": [
        "ci",
        "github",
        "sedge",
        "sedge-kit"
    ],
    "homepage": "https://sedge.sh",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sedge-hq/sedge.git",
        "directory": "packages/github"
    },
    "files": [
        "src",
        "!src/**/*.test.ts"
    ],
    "type": "module",
    "exports": {
        ".": "./src/ci.ts"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun --bun vitest run --passWithNoTests"
    },
    "dependencies": {
        "@sedge-hq/kit": "workspace:*"
    },
    "devDependencies": {
        "@sedge-hq/config": "workspace:*",
        "@types/bun": "1.4.4",
        "typescript": "7.0.2",
        "vitest": "5.1.1"
    },
    "sedge": {
        "plugins": [
            "./src/ci.ts",
            "./src/github.ts"
        ]
    }
}
