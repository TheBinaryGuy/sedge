{
    "name": "@sedge-hq/slack",
    "version": "0.0.0",
    "description": "Slack for sedge: message your agent from Slack, and it answers there.",
    "keywords": [
        "sedge",
        "sedge-kit",
        "slack"
    ],
    "homepage": "https://sedge.sh",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sedge-hq/sedge.git",
        "directory": "packages/slack"
    },
    "files": [
        "src",
        "!src/**/*.test.ts"
    ],
    "type": "module",
    "exports": {
        ".": "./src/slack.ts"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun --bun vitest run --passWithNoTests"
    },
    "dependencies": {
        "@sedge-hq/kit": "workspace:*"
    },
    "devDependencies": {
        "@sedge-hq/config": "workspace:*",
        "@types/bun": "1.4.4",
        "typescript": "7.0.2",
        "vitest": "5.1.1"
    },
    "sedge": {
        "plugins": [
            "./src/slack.ts"
        ]
    }
}
