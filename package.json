{
    "name": "sedge-monorepo",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "sedge": "SEDGE_HOME=$PWD/.sedge-dev bun apps/cli/src/main.ts",
        "build": "turbo run build",
        "build:all": "bun scripts/build.ts --all",
        "typecheck": "tsc --noEmit && turbo run typecheck",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "check": "bun run lint && bun run format:check && bun run typecheck",
        "test": "turbo run test",
        "db:generate": "bun run --cwd packages/db db:generate",
        "changeset": "changeset",
        "version": "changeset version && bun install --lockfile-only",
        "release": "bun scripts/release.ts",
        "e2e:telegram": "bun apps/cli/scripts/e2e-telegram.ts",
        "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
    },
    "devDependencies": {
        "@changesets/changelog-github": "1.0.1",
        "@changesets/cli": "3.0.3",
        "@sedge-hq/config": "workspace:*",
        "@types/bun": "1.4.4",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "oxlint-tsgolint": "7.0.2007",
        "turbo": "2.11.13",
        "typescript": "7.0.2",
        "vitest": "5.1.1"
    },
    "engines": {
        "bun": ">=1.4.4"
    },
    "packageManager": "bun@1.4.4"
}
